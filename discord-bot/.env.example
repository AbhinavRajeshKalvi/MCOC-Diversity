# Copy to .env for local runs (npm run dev). On Render, add the same keys under Environment.

# From the Discord developer portal: your application > Bot > Reset Token.
DISCORD_TOKEN=

# Optional: a server id to register the slash commands in instantly while testing.
# Leave empty in production; commands are then registered for every server the bot is in.
DISCORD_DEV_GUILD_ID=

# The same MongoDB connection string the War Room app uses (same database).
MONGODB_URI=mongodb://127.0.0.1:27017/mcoc-diversity-planner

# Link to the War Room app, used in bot messages ("Open the map") and for the
# "Review and save" link after /roster-import. Without it /roster-import is refused.
APP_URL=https://your-war-room.onrender.com

# Optional: the same VAPID keys as the app, so bookings and node requests made
# from Discord also send the app's push notifications. Leave empty to skip.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# How often the bot checks the database for new bookings, requests and roster changes.
POLL_SECONDS=20

# Render sets PORT for you. Locally the health endpoint listens on 3001.
PORT=3001
