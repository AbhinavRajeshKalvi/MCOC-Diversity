# Copy this file to .env.local before running the app.

# Any long random string (at least 16 characters). Used to sign login session tokens.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-this-to-a-long-random-string

# MongoDB connection string, including a database name.
# Local MongoDB:   mongodb://127.0.0.1:27017/mcoc-diversity-planner
# MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mcoc-diversity-planner
MONGODB_URI=mongodb://127.0.0.1:27017/mcoc-diversity-planner

# Optional: username/password for the first officer account, created automatically
# the first time the app starts against an empty database.
BOOTSTRAP_OFFICER_USERNAME=officer
BOOTSTRAP_OFFICER_PASSWORD=12345678

# Google Gemini vision API used for roster screenshot analysis.
# Create a Gemini API key in Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the Gemini model used for screenshot analysis.
GEMINI_MODEL=gemini-3.6-flash
