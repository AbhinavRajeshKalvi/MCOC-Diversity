# Copy this file to .env.local for local runs. On Render, add the same keys under Environment.

# Any long random string (at least 16 characters). Signs login session tokens.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-this-to-a-long-random-string

# MongoDB connection string, including a database name.
MONGODB_URI=mongodb://127.0.0.1:27017/mcoc-diversity-planner

# Name given to your existing alliance when the server first upgrades an old database.
# All existing members, plans and the war mode move into this alliance automatically.
LEGACY_ALLIANCE_NAME=My Alliance

# Password reset emails, sent through Resend (https://resend.com, free tier is enough).
# Without these, reset codes are only written to the server log.
RESEND_API_KEY=
EMAIL_FROM=War Room <noreply@yourdomain.com>

# Google sign-in. Comma-separated OAuth client IDs whose ID tokens are accepted.
# Put the *Web* client ID here (the same one set as googleWebClientId in the app).
GOOGLE_CLIENT_IDS=

# Contact address shown on the privacy policy and account deletion pages.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Optional: extra origins allowed to call the API from a browser (only for testing the app's web build).
CORS_ORIGINS=

# Google Gemini vision API used for roster screenshot analysis.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
